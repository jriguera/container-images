#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# amuleapi is the new Web UI + REST API. It runs as its own process (amuled
# has [AmuleApi]Enabled=0) and connects to amuled over the EC interface using
# the settings in ${CONFIGDIR}/amuleapi.conf.

# Allow disabling this service with ENABLE_AMULEAPI=false (defaults to true).
if [[ "${ENABLE_AMULEAPI:-true}" != "true" ]] && [[ "${ENABLE_AMULEAPI}" != "1" ]]
then
    echo "* amuleapi is disabled (ENABLE_AMULEAPI=${ENABLE_AMULEAPI}). Not starting."
    # Bring this service down so s6 does not restart it, then idle.
    s6-svc -d /run/service/svc-amuleapi 2>/dev/null || true
    exec sleep infinity
fi

if [[ -z ${LSIO_NON_ROOT_USER} ]]
then
    exec s6-setuidgid abc \
        env HOME="${CONFIGDIR}" \
        amuleapi --config-dir="${CONFIGDIR}" --log-stdout
else
    export HOME="${CONFIGDIR}"
    exec amuleapi --config-dir="${CONFIGDIR}" --log-stdout
fi
