#!/usr/bin/with-contenv bash
# shellcheck shell=bash

DATADIR=${DATADIR:-/data}
CONFIGDIR=${CONFIGDIR:-/config}

# make folders if required
mkdir -p "${DATADIR}" "${CONFIGDIR}" /run/amule

# load env file if it exists
if [[ -f "${CONFIGDIR}/env" ]]
then
    # shellcheck source=/dev/null
    source "${CONFIGDIR}/env"
fi

# Initialize default values for amule configuration variables
export AMULE_PORT="${AMULE_PORT:-4662}"
export AMULE_UDPPORT="${AMULE_UDPPORT:-4672}"
export AMULE_UDPENABLE="${AMULE_UDP_ENABLE:-1}"
export AMULE_EC_ECPORT="${AMULE_EC_ECPORT:-4712}"
export AMULE_EC_ADDRESS="${AMULE_EC_ADDRESS:-127.0.0.1}"
export AMULE_WEBSERVER_PORT="${AMULE_WEBSERVER_PORT:-${PORT_WEB:-4711}}"

# export AMULE_API_PORT="${AMULE_API_PORT:-${PORT_API:-4713}}"

export AMULE_WEBSERVER_TEMPLATE="${AMULE_WEBSERVER_TEMPLATE:-bootstrap}"
export AMULE_YOURHOSTNAME="${AMULE_YOURHOSTNAME:-}"

# Directories inside DATADIR
export AMULE_DATADIR_TEMP=${AMULE_DATADIR_TEMP:-temp}
export AMULE_DATADIR_INCOMING=${AMULE_DATADIR_INCOMING:-incoming}


# Password used for the Remote GUI (EC) and the Web UI. amuleapi hashes the
# EC password itself, so it needs the plaintext value.
export AMULE_PASSWORD="${AMULE_PASSWORD:-amule}"
echo "* Computing MD5 hash for password..."
AMULE_PASSWORD_HASH=$(echo -n "${AMULE_PASSWORD}" | md5sum | cut -d' ' -f1)
export AMULE_PASSWORD_HASH

# Require encrypted (obfuscated) connections from peers: 0 (default) or 1
export AMULE_CRYPT_REQUIRED="${AMULE_CRYPT_REQUIRED:-0}"

# Optional read-only guest account for the Web UI. Empty (default) = disabled
export AMULE_GUEST_PASSWORD="${AMULE_GUEST_PASSWORD:-}"
if [[ -n "${AMULE_GUEST_PASSWORD}" ]]
then
    AMULE_GUEST_ENABLED=1
    AMULE_GUEST_PASSWORD_HASH=$(echo -n "${AMULE_GUEST_PASSWORD}" | md5sum | cut -d' ' -f1)
else
    AMULE_GUEST_ENABLED=0
    AMULE_GUEST_PASSWORD_HASH=""
fi
export AMULE_GUEST_ENABLED AMULE_GUEST_PASSWORD_HASH

# Generate configuration file if GENERATE_CONFIG is true, 1, True, TRUE or not defined
if [[ -z "${GENERATE_CONFIG}" ]] || [[ "${GENERATE_CONFIG,,}" == "true" ]] || [[ "${GENERATE_CONFIG}" == "1" ]]
then
    echo "* Generating default configuration from environment variables ..."    
    # Render a template configuration file
    # expand variables + preserve formatting
    eval "echo \"$(cat /defaults/amule.conf.template)\"" > "${CONFIGDIR}/amule.conf"
    eval "echo \"$(cat /defaults/remote.conf.template)\"" > "${CONFIGDIR}/remote.conf"
    eval "echo \"$(cat /defaults/amuleapi.conf.template)\"" > "${CONFIGDIR}/amuleapi.conf"
    # amuleapi refuses to start if its config is readable by group/others
    chmod 600 "${CONFIGDIR}/amuleapi.conf"
    # Store the Web UI admin password in amuleapi's salted password file
    echo "* Setting amuleapi Web UI admin password ..."
    amuleapi --config-dir="${CONFIGDIR}" --no-log-file --set-admin-pass="${AMULE_PASSWORD}" || \
        echo "* WARNING: could not set amuleapi admin password"
    # Empty password disables the read-only guest account (amuleapi default)
    amuleapi --config-dir="${CONFIGDIR}" --no-log-file --set-guest-pass="${AMULE_GUEST_PASSWORD}" || \
        echo "* WARNING: could not set amuleapi guest password"
    chmod 600 "${CONFIGDIR}"/amuleapi-* 2>/dev/null || true
fi

# create required directories inside DATADIR
mkdir -p "${DATADIR}/${AMULE_DATADIR_TEMP}" "${DATADIR}/${AMULE_DATADIR_INCOMING}"

if [[ -z ${LSIO_NON_ROOT_USER} ]]
then
    lsiown -R abc:abc /run/amule  "${DATADIR}" "${CONFIGDIR}"
fi

# remove orphan pid file
if [[ -f /run/amule/amule.pid ]]
then
    rm -f /run/amule/amule.pid
fi
