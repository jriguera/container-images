#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Web UI service. Runs one of (both listen on the same port, so only one at a time):
#  - amuleapi: new Web UI + REST API, uses ${CONFIGDIR}/amuleapi.conf
#  - amuleweb: legacy Web UI, uses ${CONFIGDIR}/remote.conf
# amuled has [WebServer]Enabled=0 and [AmuleApi]Enabled=0, so they always run
# here as their own process and connect to amuled over the EC interface.
#
# Selection: ENABLE_AMULEAPI=true (default) wins over ENABLE_AMULEWEB=true.
# If both are false, the service is disabled.

is_true() { [[ "${1,,}" == "true" ]] || [[ "$1" == "1" ]]; }

if is_true "${ENABLE_AMULEAPI:-true}"
then
    echo "* Starting amuleapi (Web UI + REST API) ..."
    cmd=(amuleapi --config-dir="${CONFIGDIR}" --no-log-file)
elif is_true "${ENABLE_AMULEWEB:-true}"
then
    echo "* Starting amuleweb (legacy Web UI) ..."
    cmd=(amuleweb --amule-config-file="${CONFIGDIR}/amule.conf")
else
    echo "* Web UI is disabled (ENABLE_AMULEAPI=${ENABLE_AMULEAPI}, ENABLE_AMULEWEB=${ENABLE_AMULEWEB}). Not starting."
    # Bring this service down so s6 does not restart it, then idle.
    s6-svc -d /run/service/svc-amuleweb 2>/dev/null || true
    exec sleep infinity
fi

export HOME="${CONFIGDIR}"
if [[ -z ${LSIO_NON_ROOT_USER} ]]
then
    exec s6-setuidgid abc "${cmd[@]}"
else
    exec "${cmd[@]}"
fi
