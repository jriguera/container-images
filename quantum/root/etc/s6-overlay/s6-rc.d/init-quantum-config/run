#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# FileBrowser Quantum configuration parameters and defaults
FB_PORT="${FB_PORT:-${PORT:-8000}}"
FB_BASE_URL="${FB_BASE_URL:-/}"
FB_SOURCE="${FB_SOURCE:-${DATADIR:-/data}}"
FB_DATABASE="${FB_DATABASE:-${CONFIGDIR}/filebrowser.sqlite}"
FB_CACHE_DIR="${FB_CACHE_DIR:-${CONFIGDIR}/tmp}"
FB_CONFIG_FILE="${FB_CONFIG_FILE:-${CONFIGDIR}/config.yaml}"
FB_LOG_LEVEL="${FB_LOG_LEVEL:-info|warning|error}"
# Admin account rendered into the config file
FB_ADMIN_USER="${FB_ADMIN_USER:-admin}"
FB_ADMIN_PASSWORD="${FB_ADMIN_PASSWORD:-admin}"
FB_PASSWORD_MIN_LENGTH="${FB_PASSWORD_MIN_LENGTH:-2}"
# Directory holding the ffmpeg/ffprobe binaries (enables media thumbnails).
# Set to an empty string to disable the media integration.
FB_FFMPEG_PATH="${FB_FFMPEG_PATH-/usr/bin}"
# Reset database on startup
RESET_DB="${RESET_DB:-false}"

# make folders if required
mkdir -p "${DATADIR}" "${CONFIGDIR}" "${FB_CACHE_DIR}" /run/filebrowser

# load env file if it exists
if [[ -f "${CONFIGDIR}/env" ]]
then
    # shellcheck source=/dev/null
    source "${CONFIGDIR}/env"
fi

if [[ "${FB_CONFIG_FILE}" == "${CONFIGDIR}/config.yaml" ]]
then
    echo "* Generating default configuration from environment variables ..."
    # Render the YAML configuration from the environment. Using a heredoc keeps
    # the YAML valid and lets bash expand the variables naturally.
    cat > "${FB_CONFIG_FILE}" <<EOF
# Generated by init-quantum-config from environment variables.
# To use your own configuration, mount a file and set FB_CONFIG_FILE to it.
# NOTE: this schema targets the v2.x version
http:
  port: ${FB_PORT}
  baseURL: "${FB_BASE_URL}"

server:
  database:
    path: "${FB_DATABASE}"
  cacheDir: "${FB_CACHE_DIR}"
  logging:
    - levels: "${FB_LOG_LEVEL}"
  sources:
    - path: "${FB_SOURCE}"
      config:
        defaultEnabled: true

auth:
  adminUsername: "${FB_ADMIN_USER}"
  adminPassword: "${FB_ADMIN_PASSWORD}"
  methods:
    password:
      enabled: true
      minLength: ${FB_PASSWORD_MIN_LENGTH}
EOF
    # Enable ffmpeg-based media/office thumbnails when the binaries are present
    if [[ -n "${FB_FFMPEG_PATH}" && -x "${FB_FFMPEG_PATH}/ffmpeg" ]]
    then
        cat >> "${FB_CONFIG_FILE}" <<EOF

integrations:
  media:
    ffmpegPath: "${FB_FFMPEG_PATH}"
EOF
    fi
else
    echo "* Using provided configuration file ${FB_CONFIG_FILE} ..."
fi

# Optionally reset the database
if [[ "${RESET_DB}" =~ (true|TRUE|True) ]]
then
    echo "* Reseting DB: Removing existing database file ${FB_DATABASE} ..."
    rm -f "${FB_DATABASE}"
fi

if [[ -z ${LSIO_NON_ROOT_USER} ]]
then
    lsiown -R abc:abc /run/filebrowser "${DATADIR}" "${CONFIGDIR}"
fi
